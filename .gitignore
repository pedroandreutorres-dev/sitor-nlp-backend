data/resultados/*.csv

# Excepciones
!data/processed/tracker_en.csv
!data/processed/tracker_es.csv

# Archivos de configuracion de entorno y secretos
.env
.env.*

# Configuraciones de IDE y editores
.vscode/
.idea/
*.swp
*.swo

# Carpetas de modelos binarios
models/
notebook/checkpoints/

