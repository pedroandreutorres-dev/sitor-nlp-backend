# ==============================================================================
# SITOR - .gitignore (Configuración Oficial TFM)
# ==============================================================================

# Entornos virtuales y configuraciones locales
.venv/
venv/
env/
.env
.env.*
.vscode/
.idea/

# Archivos de cache y compilados de Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
htmlcov/
.coverage

# Jupyter Notebooks
.ipynb_checkpoints/

# Datos pesados (Evitar sobrepasar el límite de 100MB de GitHub)
data/raw/*.csv
data/gold/*.parquet
data/resultados/*.csv
data/resultados/*.json
data/outbox/*.json

# Modelos binarios pesados (PyTorch / Safetensors)
src/models/**/*.safetensors
src/models/**/*.bin
src/models/**/*.h5
src/models/**/*.pt

# Archivos temporales de despliegue o logs
scratch/
*.log
*.swp
*.swo
.DS_Store
Thumbs.db

# ==============================================================================
# EXCEPCIONES IMPORTANTES (Se fuerza a GIT a trackearlos)
# ==============================================================================
!data/raw/.gitkeep
!data/inbox/batch_operaciones_demo.json